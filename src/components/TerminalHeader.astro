---
import { SITE_TITLE, SITE_TAGLINE, SITE_VERSION, SITE_BUILD_ID } from '../consts';
import TerminalToggles from './TerminalToggles.astro';

const buildDate = new Date()
  .toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  .toUpperCase();

const { pathname } = Astro.url;
const current = (path: string) =>
  pathname === path || pathname === path.replace(/\/$/, '') ? 'page' : undefined;
---

<header class="t-header">
  <a class="logo" href="/" aria-label="На главную">
    <span class="logo-glyph" aria-hidden="true">&gt;_</span>
    <span class="logo-name">{SITE_TITLE}</span>
  </a>
  <div class="h-info">
    <div class="h-line h-line-top">{SITE_TAGLINE}</div>
    <div class="h-line h-line-bottom">
      <span>BUILD: {SITE_BUILD_ID} VER {SITE_VERSION}</span>
      <span>{buildDate}</span>
    </div>
    <nav class="h-nav" aria-label="Основная навигация">
      <a href="/" aria-current={current('/')}>&gt; HOME</a>
      <a href="/blog/" aria-current={current('/blog/')}>&gt; ARCHIVE</a>
      <a href="/about/" aria-current={current('/about/')}>&gt; ABOUT</a>
      <a href="/rss.xml">&gt; RSS</a>
      <TerminalToggles class="toggles--header" />
    </nav>
  </div>
</header>
