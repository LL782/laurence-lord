---
interface Props {
  src: string;
}

const { src } = Astro.props;

---

<iframe class="embed-frame" width="1" height="1" src={src} />

<style>
  .embed-frame {
    border-width: 0;
    height: 100vw;
    max-height: 480px;
    max-width: 640px;
    margin-left: -2px;
    margin-right: 0;
    margin-top: 1px;
    margin-bottom: 1px;
    width: 100vw;
  }
</style>