---
interface Note {
  slug: string;
  data: {
    title: string;
  };
}

interface Props {
  allNotes: Note[];
  currentSlug: string;
}

const { allNotes, currentSlug } = Astro.props;

if (allNotes.length < 2) {
  return null;
}

const indexOfCurrent = allNotes.findIndex(({ slug }) => slug === currentSlug);
const olderIndex = indexOfCurrent + 1;
const newerIndex = indexOfCurrent - 1;

const older = olderIndex < allNotes.length ? allNotes[olderIndex] : null;
const newer = newerIndex > -1 ? allNotes[newerIndex] : null;
---

{
  newer ? (
    <a class="tile box-lg" href={`/notes/${newer.slug}/`}>
      <span class="tile-kicker">Newer</span>
      <span class="tile-label">{newer.data.title}</span>
    </a>
  ) : (
    <div class="tile box-lg">
      <span class="tile-kicker">Newer</span>
      <p class="elf">Nothing newer</p>
    </div>
  )
}
{
  older ? (
    <a class="tile box-lg" href={`/notes/${older.slug}/`}>
      <span class="tile-kicker">Older</span>
      <span class="tile-label">{older.data.title}</span>
    </a>
  ) : (
    <div class="tile box-lg">
      <span class="tile-kicker">Older</span>
      <p class="elf">Nothing older</p>
    </div>
  )
}
