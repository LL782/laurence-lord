---
import { siteConfig } from "../site-config";

interface Props {
  simple?: boolean;
}

const { simple = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <hr />
  {
    !simple && (
      <p>
        <a href={siteConfig.githubProfile}>GitHub</a>
      </p>
    )
  }
  <p>&copy; {year} Laurence Lord</p>
</footer>
