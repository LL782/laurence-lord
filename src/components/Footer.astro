---
import EditOnGitHubInvite from "./EditOnGitHubInvite.astro";

interface Props {
  editPath?: string;
}

const { editPath } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <hr />
  <div class="footer-bar">
    <p class="footer-copy">&copy; {year} Laurence Lord</p>
    {editPath && <EditOnGitHubInvite path={editPath} />}
  </div>
</footer>
