---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditOnGitHubInvite from "../../components/EditOnGitHubInvite.astro";
import NewerOlder from "../../components/NewerOlder.astro";
import BlockQuote from "../../components/mdx/BlockQuote.astro";
import EmbedFrame from "../../components/mdx/EmbedFrame.astro";
import Emoji from "../../components/mdx/Emoji.astro";
import Stub from "../../components/mdx/Stub.astro";
import Message from "../../components/mdx/Message.astro";
import Link from "../../components/mdx/Link.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  const sortedNotes = [...notes].sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return sortedNotes.map((note) => ({
    params: { slug: note.slug },
    props: { note, allNotes: sortedNotes },
  }));
}

interface Props {
  note: CollectionEntry<"notes">;
  allNotes: CollectionEntry<"notes">[];
}

const { note, allNotes } = Astro.props;
const { Content } = await note.render();

const { title, description, image, imageAlt, imageLink, imageAnchor, afterthoughts } =
  note.data;

const seoImage = image
  ? (await getImage({ src: image, width: 1200, height: 400 })).src
  : undefined;
---

<BaseLayout title={title} description={description} image={seoImage} imageAlt={imageAlt}>
  <a class="tile box-sm" href="/notes/">
    <span class="tile-kicker">Notes</span>
    <span class="tile-label">All notes</span>
  </a>

  <h1 class="tile span-3-lg h-auto">{title}</h1>

  {
    image &&
      (imageLink ? (
        <a class="tile tile--flush span-2-lg h-lg" href={imageLink}>
          <Image
            class="tile-media"
            src={image}
            alt={imageAlt || title}
            widths={[350, 750, 1150]}
            sizes="(max-width: 799px) min(350px, 100vw), (max-width: 1249px) 750px, 750px"
          />
        </a>
      ) : imageAnchor ? (
        <a class="tile tile--flush span-2-lg h-lg" href={imageAnchor}>
          <Image
            class="tile-media"
            src={image}
            alt={imageAlt || title}
            widths={[350, 750, 1150]}
            sizes="(max-width: 799px) min(350px, 100vw), (max-width: 1249px) 750px, 750px"
          />
        </a>
      ) : (
        <div class="tile tile--flush span-2-lg h-lg">
          <Image
            class="tile-media"
            src={image}
            alt={imageAlt || title}
            widths={[350, 750, 1150]}
            sizes="(max-width: 799px) min(350px, 100vw), (max-width: 1249px) 750px, 750px"
          />
        </div>
      ))
  }

  <section class="tile span-3-lg h-fluid prose">
    <Content
      components={{
        BlockQuote,
        EmbedFrame,
        Emoji,
        Stub,
        Message,
        Link,
      }}
    />
  </section>

  {
    afterthoughts && (
      <aside class="tile box-lg">
        <h2 class="human">Afterthoughts</h2>
        <p class="elf tile-fill">{afterthoughts}</p>
      </aside>
    )
  }

  <NewerOlder allNotes={allNotes} currentSlug={note.slug} />
  <EditOnGitHubInvite path={`/src/content/notes/${note.slug}.mdx`} />
</BaseLayout>
