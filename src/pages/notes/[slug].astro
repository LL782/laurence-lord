---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteIndex from "../../components/NoteIndex.astro";
import {
  listedNotes,
  relatedListedNotes,
  relatedOffsetLabel,
  sortNotesNewestFirst,
} from "../../lib/notes";
import BlockQuote from "../../components/mdx/BlockQuote.astro";
import EmbedFrame from "../../components/mdx/EmbedFrame.astro";
import Emoji from "../../components/mdx/Emoji.astro";
import Stub from "../../components/mdx/Stub.astro";
import Message from "../../components/mdx/Message.astro";
import Link from "../../components/mdx/Link.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  const sortedNotes = sortNotesNewestFirst(notes);
  const listed = listedNotes(sortedNotes);

  return sortedNotes.map((note) => ({
    params: { slug: note.slug },
    props: { note, listedNotes: listed },
  }));
}

interface Props {
  note: CollectionEntry<"notes">;
  listedNotes: CollectionEntry<"notes">[];
}

const { note, listedNotes: listed } = Astro.props;
const { Content } = await note.render();

const { title, description, date, image, imageAlt, imageLink, imageAnchor, afterthoughts } =
  note.data;

const noteDate = date.toISOString().slice(0, 10);
const related = relatedListedNotes(listed, note.slug);
const relatedNotes = related.map(({ note: relatedNote }) => relatedNote);
const labels = new Map(
  related.map(({ note: relatedNote, offset }) => [
    relatedNote.slug,
    relatedOffsetLabel(offset),
  ]),
);
const seoImage = image
  ? (await getImage({ src: image, width: 1200, height: 400 })).src
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  image={seoImage}
  imageAlt={imageAlt}
  editPath={`/src/content/notes/${note.slug}.mdx`}
>
  <article>
    <header class="page-header">
      <p class="page-kicker">
        <time datetime={noteDate}>{noteDate}</time>
      </p>
      <h1>{title}</h1>
    </header>
    {
      image &&
        (imageLink ? (
          <a href={imageLink}>
            <Image
              class="note-hero-image"
              src={image}
              alt={imageAlt || title}
              widths={[640, 960, 1200]}
              sizes="(max-width: 764px) 100vw, 764px"
            />
          </a>
        ) : imageAnchor ? (
          <a href={imageAnchor}>
            <Image
              class="note-hero-image"
              src={image}
              alt={imageAlt || title}
              widths={[640, 960, 1200]}
              sizes="(max-width: 764px) 100vw, 764px"
            />
          </a>
        ) : (
          <Image
            class="note-hero-image"
            src={image}
            alt={imageAlt || title}
            widths={[640, 960, 1200]}
            sizes="(max-width: 764px) 100vw, 764px"
          />
        ))
    }
    <section>
      <Content
        components={{
          BlockQuote,
          EmbedFrame,
          Emoji,
          Stub,
          Message,
          Link,
        }}
      />
    </section>
    {
      afterthoughts && (
        <aside>
          <h2>Afterthoughts</h2>
          <p>{afterthoughts}</p>
        </aside>
      )
    }
  </article>

  {
    relatedNotes.length > 0 && (
      <section class="related-notes" aria-labelledby="related-notes-heading">
        <h2 class="section-label" id="related-notes-heading">More notes</h2>
        <NoteIndex notes={relatedNotes} labels={labels} />
      </section>
    )
  }
</BaseLayout>
