---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditOnGitHubInvite from "../../components/EditOnGitHubInvite.astro";

const notes = (await getCollection("notes", ({ data }) => !data.private)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="My Notes">
  <h1>My Notes</h1>
  <p>
    You're welcome to dive in, just be aware{" "}
    <a href="/notes/i-am-writing-for-myself/">I write them for myself</a>.
  </p>
  <hr />
  {
    notes.map((note) => {
      const date = note.data.date.toISOString().slice(0, 10);
      return (
        <a href={`/notes/${note.slug}/`}>
          <h2>{note.data.title}</h2>
          <p>
            <time class="note-date" datetime={date}>
              {date}
            </time>
          </p>
        </a>
      );
    })
  }
  <EditOnGitHubInvite path="/src/pages/notes/index.astro" />
</BaseLayout>
