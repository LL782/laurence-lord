---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteIndex from "../../components/NoteIndex.astro";
import {
  listedNotes,
  noteIndexNumbers,
  sortNotesNewestFirst,
} from "../../lib/notes";

const notes = sortNotesNewestFirst(listedNotes(await getCollection("notes")));
const labels = new Map(
  [...noteIndexNumbers(notes)].map(([slug, number]) => [
    slug,
    String(number).padStart(2, "0"),
  ]),
);
---

<BaseLayout title="My Notes" editPath="/src/pages/notes/index.astro">
  <header class="page-header">
    <p class="page-kicker">Index</p>
    <h1>My notes</h1>
    <p class="page-lede">
      You're welcome to dive in, just be aware:
      <a href="/notes/i-am-writing-for-myself/">I'm writing for myself</a>.
    </p>
  </header>

  <NoteIndex notes={notes} labels={labels} />
</BaseLayout>
