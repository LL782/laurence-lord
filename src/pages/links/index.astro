---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditOnGitHubInvite from "../../components/EditOnGitHubInvite.astro";
import { siteLinks } from "../../data/links";
---

<BaseLayout
  title="Links"
  description="Places I show up online — with a little context for each."
>
  <header class="page-header">
    <p class="page-kicker">Elsewhere</p>
    <h1>Links</h1>
    <p class="page-lede">
      A short map of where I publish, share and work in public — each with a
      little context, not just a name.
    </p>
  </header>

  <ul class="link-cards">
    {
      siteLinks.map((link) => (
        <li class="link-card">
          <a
            class="link-card__anchor"
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            <Image
              class="link-card__image"
              src={link.image}
              alt={link.imageAlt}
              widths={[320, 640, 960]}
              sizes="(max-width: 700px) 100vw, 280px"
            />
            <span class="link-card__body">
              <span class="link-card__title">{link.title}</span>
              <span class="link-card__text">{link.body}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <EditOnGitHubInvite path="/src/pages/links/index.astro" />
</BaseLayout>
