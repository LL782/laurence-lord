---
import heroImage from "../../../assets/crop-of-punk-storm.png";

const heroUrl = heroImage.src;

const navLinks = [
  { slug: "ll782-poster", label: "../notes/ll782-poster" },
  { slug: "i-am-writing-for-myself", label: "../notes/i-am-writing-for-myself" },
  { slug: "a-frame-001", label: "../notes/a-frame-001" },
  { slug: "3d-webgl-first-steps-variables", label: "../notes/3d-webgl-first-steps-variables" },
];

const labSlug = "ink-neon-terminal";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ink &amp; Neon Terminal — Laurence Lord Labs</title>
    <meta
      name="description"
      content="Lab experiment: dark terminal aesthetic with magenta and lime chrome, tilted mask panels, and live cursor metadata."
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <style define:vars={{ heroUrl }}>
      :root {
        --interactive-x: 0.5;
        --interactive-y: 0.5;
        --magenta: #ff00ff;
        --lime: #00ff00;
        --ink: #000;
        --hero-url: var(--heroUrl);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        background: var(--ink);
        color: var(--lime);
        font-family: "Courier New", Courier, monospace;
        height: 100vh;
        margin: 0;
        overflow: hidden;
        position: relative;
      }

      body::before {
        background-image: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 0, 255, 0.03) 2px,
          rgba(255, 0, 255, 0.03) 4px
        );
        content: "";
        inset: 0;
        pointer-events: none;
        position: fixed;
        z-index: 0;
      }

      .stage {
        align-items: center;
        display: flex;
        height: 100vh;
        justify-content: center;
        perspective: 28vw;
        perspective-origin: 50% 45%;
        position: relative;
        transform-style: preserve-3d;
        z-index: 1;
      }

      .panel-stack {
        position: relative;
        transform: rotateY(calc((var(--interactive-x) * 2 - 1) * 18deg))
          rotateX(calc((var(--interactive-y) * 2 - 1) * -12deg));
        transform-style: preserve-3d;
        transition: transform 0.08s linear;
        width: min(72vw, 820px);
      }

      .panel {
        background-image: var(--hero-url);
        background-size: cover;
        background-position: center;
        border: 1px solid var(--magenta);
        box-shadow:
          0 0 12px rgba(255, 0, 255, 0.45),
          inset 0 0 24px rgba(0, 0, 0, 0.6);
        height: clamp(180px, 28vw, 320px);
        left: 50%;
        position: absolute;
        top: 50%;
        width: clamp(220px, 38vw, 420px);
      }

      .panel::after {
        background: linear-gradient(
          135deg,
          rgba(255, 0, 255, 0.12) 0%,
          transparent 40%,
          rgba(0, 255, 0, 0.08) 100%
        );
        content: "";
        inset: 0;
        mix-blend-mode: screen;
        pointer-events: none;
        position: absolute;
      }

      .panel--a {
        clip-path: polygon(8% 0%, 100% 6%, 92% 100%, 0% 94%);
        transform: translate(-58%, -72%) rotate(-6deg) translateZ(40px);
        z-index: 3;
      }

      .panel--b {
        clip-path: polygon(0% 12%, 94% 0%, 100% 88%, 6% 100%);
        filter: saturate(1.15) contrast(1.05);
        transform: translate(-42%, -38%) rotate(4deg) translateZ(0px);
        z-index: 2;
      }

      .panel--c {
        clip-path: polygon(12% 0%, 100% 18%, 88% 100%, 0% 82%);
        opacity: 0.92;
        transform: translate(-48%, -8%) rotate(-2deg) translateZ(-30px);
        z-index: 1;
      }

      .scanline {
        animation: scan 6s linear infinite;
        background: linear-gradient(
          transparent 0%,
          rgba(0, 255, 0, 0.06) 48%,
          rgba(255, 0, 255, 0.12) 50%,
          transparent 52%
        );
        height: 120%;
        left: -10%;
        pointer-events: none;
        position: absolute;
        top: -10%;
        width: 120%;
        z-index: 4;
      }

      @keyframes scan {
        0% {
          transform: translateY(-8%);
        }
        100% {
          transform: translateY(8%);
        }
      }

      .interactive-zone {
        inset: 0;
        position: fixed;
        z-index: 5;
      }

      .chrome {
        pointer-events: none;
        position: fixed;
        z-index: 10;
      }

      .chrome--top {
        border-bottom: 1px solid var(--magenta);
        left: 0;
        padding: 1rem 1.25rem;
        right: 0;
        top: 0;
      }

      .breadcrumb {
        color: var(--magenta);
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        margin: 0;
        text-shadow: 0 0 8px rgba(255, 0, 255, 0.6);
      }

      .breadcrumb span {
        color: var(--lime);
      }

      .chrome--bottom {
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.92), rgba(0, 0, 0, 0.55));
        border-top: 1px solid var(--lime);
        bottom: 0;
        left: 0;
        padding: 1rem 1.25rem 1.25rem;
        right: 0;
      }

      .meta-console {
        color: var(--lime);
        font-size: 0.8rem;
        line-height: 1.55;
        margin: 0;
        text-shadow: 0 0 6px rgba(0, 255, 0, 0.35);
      }

      .meta-console .label {
        color: var(--magenta);
      }

      .meta-console .value {
        color: var(--lime);
      }

      .terminal-nav {
        border-left: 1px solid var(--magenta);
        max-width: 22rem;
        padding: 1.25rem;
        pointer-events: auto;
        position: fixed;
        right: 0;
        top: 3.5rem;
        z-index: 10;
      }

      .terminal-nav__title {
        color: var(--magenta);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        margin: 0 0 0.75rem;
        text-transform: uppercase;
      }

      .terminal-nav a {
        border-left: 2px solid transparent;
        color: var(--lime);
        display: block;
        font-size: 0.82rem;
        margin: 0.35rem 0;
        padding: 0.35rem 0 0.35rem 0.5rem;
        text-decoration: none;
        transition:
          border-color 0.15s,
          color 0.15s,
          text-shadow 0.15s;
      }

      .terminal-nav a:hover,
      .terminal-nav a:focus,
      .terminal-nav a.is-active {
        border-left-color: var(--magenta);
        color: #fff;
        outline: none;
        text-shadow: 0 0 10px rgba(0, 255, 0, 0.8);
      }

      .terminal-nav a::before {
        color: var(--magenta);
        content: "> ";
      }

      .home-link {
        border: 1px solid var(--magenta);
        bottom: 1.25rem;
        color: var(--magenta);
        font-size: 0.78rem;
        left: 1.25rem;
        padding: 0.45rem 0.75rem;
        pointer-events: auto;
        position: fixed;
        text-decoration: none;
        transition:
          background 0.15s,
          box-shadow 0.15s,
          color 0.15s;
        z-index: 10;
      }

      .home-link:hover,
      .home-link:focus {
        background: rgba(255, 0, 255, 0.12);
        box-shadow: 0 0 12px rgba(255, 0, 255, 0.45);
        color: #fff;
        outline: none;
      }

      .toggle {
        appearance: none;
        background: rgba(0, 0, 0, 0.75);
        border: 1px solid var(--lime);
        bottom: 1.25rem;
        color: var(--lime);
        cursor: pointer;
        font-family: inherit;
        font-size: 0.78rem;
        padding: 0.45rem 0.75rem;
        pointer-events: auto;
        position: fixed;
        right: 1.25rem;
        transition: opacity 0.4s;
        z-index: 10;
      }

      .toggle:hover,
      .toggle:focus {
        box-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
        outline: none;
      }

      body.hide-chrome .chrome,
      body.hide-chrome .terminal-nav,
      body.hide-chrome .home-link {
        opacity: 0;
        pointer-events: none;
      }

      body.hide-chrome .toggle {
        opacity: 0.35;
      }

      body.hide-chrome .toggle:hover {
        opacity: 1;
      }

      @media (max-width: 720px) {
        .terminal-nav {
          border-left: none;
          border-top: 1px solid var(--magenta);
          bottom: 5.5rem;
          left: 0;
          max-width: none;
          right: 0;
          top: auto;
        }

        .panel-stack {
          width: 92vw;
        }
      }
    </style>

    <div class="stage">
      <div class="panel-stack" id="panelStack">
        <div class="panel panel--a" aria-hidden="true"></div>
        <div class="panel panel--b" aria-hidden="true"></div>
        <div class="panel panel--c" aria-hidden="true"></div>
        <div class="scanline" aria-hidden="true"></div>
      </div>
    </div>

    <div class="interactive-zone" id="interactiveArea"></div>

    <header class="chrome chrome--top">
      <p class="breadcrumb">
        ../<span>labs</span>/<span>{labSlug}</span>
      </p>
    </header>

    <nav class="terminal-nav" aria-label="Notes navigation">
      <p class="terminal-nav__title">ls ../notes/</p>
      {
        navLinks.map(({ slug, label }) => (
          <a href={`/notes/${slug}/`} data-slug={slug}>
            {label.replace("../notes/", "")}
          </a>
        ))
      }
    </nav>

    <a class="home-link" href="/labs/">../labs/</a>

    <footer class="chrome chrome--bottom">
      <pre class="meta-console" id="metaConsole">
<span class="label">ink-neon-terminal</span> — live feed
---
cursor: <span class="value" id="cursorState">...waiting for input...</span>
x: <span class="value" id="x">0.000</span>
y: <span class="value" id="y">0.000</span>
slug: <span class="value" id="slugDisplay">{labSlug}</span>
      </pre>
    </footer>

    <button class="toggle" id="chromeToggle" type="button">toggle chrome</button>

    <script is:inline define:vars={{ labSlug }}>
      const interactiveArea = document.getElementById("interactiveArea");
      const consoleX = document.getElementById("x");
      const consoleY = document.getElementById("y");
      const cursorState = document.getElementById("cursorState");
      const slugDisplay = document.getElementById("slugDisplay");
      const rootStyle = document.documentElement.style;
      const navLinks = document.querySelectorAll(".terminal-nav a");

      let mouseDetected = false;
      let activeSlug = labSlug;

      interactiveArea.addEventListener("mousemove", (event) => {
        if (!mouseDetected) {
          cursorState.textContent = "tracking";
          mouseDetected = true;
        }

        const portionX = event.clientX / window.innerWidth;
        const portionY = event.clientY / window.innerHeight;

        consoleX.textContent = portionX.toFixed(3);
        consoleY.textContent = portionY.toFixed(3);
        rootStyle.setProperty("--interactive-x", portionX);
        rootStyle.setProperty("--interactive-y", portionY);
      });

      interactiveArea.addEventListener("mouseleave", () => {
        cursorState.textContent = "idle";
      });

      navLinks.forEach((link) => {
        link.addEventListener("mouseenter", () => {
          activeSlug = link.dataset.slug;
          slugDisplay.textContent = activeSlug;
          navLinks.forEach((item) => item.classList.remove("is-active"));
          link.classList.add("is-active");
        });

        link.addEventListener("focus", () => {
          activeSlug = link.dataset.slug;
          slugDisplay.textContent = activeSlug;
          navLinks.forEach((item) => item.classList.remove("is-active"));
          link.classList.add("is-active");
        });

        link.addEventListener("mouseleave", () => {
          activeSlug = labSlug;
          slugDisplay.textContent = activeSlug;
          link.classList.remove("is-active");
        });

        link.addEventListener("blur", () => {
          activeSlug = labSlug;
          slugDisplay.textContent = activeSlug;
          link.classList.remove("is-active");
        });
      });

      let chromeVisible = true;
      document.getElementById("chromeToggle").addEventListener("click", () => {
        chromeVisible = !chromeVisible;
        document.body.classList.toggle("hide-chrome", !chromeVisible);
      });
    </script>
  </body>
</html>
