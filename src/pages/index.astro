---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditOnGitHubInvite from "../components/EditOnGitHubInvite.astro";
import heroImage from "../assets/crop-of-punk-storm.png";
import { Image } from "astro:assets";

const links = [
  { href: "/notes/", label: "Notes" },
  { href: "/labs/", label: "Labs" },
  { href: "https://github.com/LL782", label: "GitHub" },
  { href: "https://www.linkedin.com/in/ll782", label: "LinkedIn" },
  {
    href: "https://www.instagram.com/laurence_lord_art/",
    label: "Instagram",
    external: true,
  },
  { href: "https://www.dc5b.com/", label: "DC5B" },
];
---

<BaseLayout isHome={true} dense>
  <div class="tile box-lg home-identity">
    <h1 class="colossus">Laurence "DC5B" Lord</h1>
    <p class="giant">Creative Developer</p>
  </div>
  <div class="tile tile--flush span-2-lg h-lg home-hero">
    <Image
      class="tile-media"
      src={heroImage}
      alt="Closely cropped black ink artwork of branches, flowers and masked faces"
      widths={[350, 750, 1150]}
      sizes="(max-width: 799px) min(350px, 100vw), (max-width: 1249px) 750px, 750px"
    />
  </div>
  <p class="tile box-lg h-2-sm home-intro elf">
    I craft websites, develop businesses and draw pictures.
  </p>
  {
    links.map(({ href, label, external }) => (
      <a
        class="tile box-sm"
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
      >
        <span class="tile-label">{label}</span>
      </a>
    ))
  }
  <EditOnGitHubInvite path="/src/pages/index.astro" />
</BaseLayout>
