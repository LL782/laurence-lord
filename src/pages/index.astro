---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditOnGitHubInvite from "../components/EditOnGitHubInvite.astro";
import heroImage from "../assets/crop-of-punk-storm.png";
import { Image } from "astro:assets";
---

<BaseLayout isHome={true}>
  <h1>Laurence "DC5B" Lord</h1>
  <h2>Creative Developer</h2>
  <Image
    class="home-hero-image"
    src={heroImage}
    alt="Closely cropped black ink artwork of branches, flowers and masked faces"
    widths={[640, 960, 1280]}
    sizes="(max-width: 764px) 100vw, 764px"
  />
  <p>I craft websites, develop businesses and draw pictures.</p>
  <ul>
    <li>
      <a href="/notes/">Notes</a>
    </li>
    <li>
      <a href="/labs/">Experiments</a>
    </li>
    <li>
      <a href="https://github.com/LL782">GitHub</a>
    </li>
    <li>
      <a href="https://www.linkedin.com/in/ll782">LinkedIn</a>
    </li>
    <li>
      <a
        href="https://www.instagram.com/laurence_lord_art/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>
    </li>
    <li>
      <a href="https://www.dc5b.com/">DC5B</a>
    </li>
  </ul>
  <EditOnGitHubInvite path="/src/pages/index.astro" />
</BaseLayout>
