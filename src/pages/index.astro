---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/crop-of-punk-storm.png";
import { Image } from "astro:assets";
import { siteConfig } from "../site-config";
import { siteLinks } from "../data/links";
---

<BaseLayout isHome={true} editPath="/src/pages/index.astro">
  <header class="home-header">
    <p class="home-kicker">Personal site</p>
    <h1>{siteConfig.defaultTitle}</h1>
    <h2>{siteConfig.headline}</h2>
  </header>

  <Image
    class="home-hero-image"
    src={heroImage}
    alt="Closely cropped black ink artwork of branches, flowers and masked faces"
    widths={[640, 960, 1280, 1600]}
    sizes="(max-width: 900px) 100vw, 960px"
  />

  <section class="home-intro">
    <h3>Art, software and systems</h3>
    <p>
      <strong>Get out of your head!</strong> Organise your thoughts before your eyes.
      Work with your hands and teeth to put ideas into practice. The shareable world
      is the testing ground where they will grow, die and (hopefully) be reborn.
    </p>
    <p>
      My thinking spans multiple projects, disciplines and passions. I am always
      looking for underlying patterns that are generally applicable.
    </p>
  </section>

  <section class="home-section">
    <h2 class="section-label">Explore</h2>
    <ul class="home-index">
      <li>
        <a href="/notes/">
          <span class="home-index__number">01</span>
          <span class="home-index__body">
            <span class="home-index__title">Notes</span>
            <span class="home-index__desc"
              >Writing for myself, shared openly</span
            >
          </span>
        </a>
      </li>
      <li>
        <a href="/labs/">
          <span class="home-index__number">02</span>
          <span class="home-index__body">
            <span class="home-index__title">Labs</span>
            <span class="home-index__desc"
              >Browser experiments and prototypes</span
            >
          </span>
        </a>
      </li>
    </ul>
  </section>

  <section class="home-section" id="links">
    <h2 class="section-label">Links</h2>

    {/* Default: simple list. Enable rich cards with ?richLinks */}
    <script is:inline>
      (() => {
        const params = new URLSearchParams(window.location.search);
        const value = params.get("richLinks");
        const enabled =
          params.has("richLinks") && value !== "0" && value !== "false";
        if (enabled) {
          document.documentElement.dataset.richLinks = "true";
        }
      })();
    </script>

    <ul class="link-list" data-links-simple>
      {
        siteLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="link-cards" data-links-rich>
      {
        siteLinks.map((link) => (
          <li class="link-card">
            <a
              class="link-card__anchor"
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              <Image
                class="link-card__image"
                src={link.image}
                alt={link.imageAlt}
                widths={[320, 640, 960]}
                sizes="(max-width: 700px) 100vw, 280px"
              />
              <span class="link-card__body">
                <span class="link-card__title">{link.title}</span>
                <span class="link-card__text">{link.body}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style is:global>
  [data-links-rich] {
    display: none;
  }

  html[data-rich-links="true"] [data-links-simple] {
    display: none;
  }

  html[data-rich-links="true"] [data-links-rich] {
    display: grid;
  }
</style>
