---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";

interface Props {
  isHome?: boolean;
  simpleFooter?: boolean;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  isHome = false,
  simpleFooter = false,
  title,
  description,
  image,
  imageAlt,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      isHome={isHome}
    />
  </head>
  <body>
    <div class="page tessellation">
      {
        !isHome && (
          <header class="main-contents">
            <a class="tile box-sm tile-header" href="/">
              <span class="tile-kicker">Home</span>
              <span class="tile-label">
                Laurence "DC5B" Lord
                <span class="elf">Creative Developer</span>
              </span>
            </a>
          </header>
        )
      }

      <main class="main-contents">
        <slot />
      </main>
      <Footer simple={simpleFooter} />
    </div>
  </body>
</html>
