---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import SiteNav from "../components/SiteNav.astro";

interface Props {
  isHome?: boolean;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  editPath?: string;
}

const {
  isHome = false,
  title,
  description,
  image,
  imageAlt,
  editPath,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      isHome={isHome}
    />
  </head>
  <body>
    <div class="site-shell">
      <aside class="site-sidebar">
        <SiteNav />
      </aside>

      <div class="site-main">
        <div class="page">
          <main>
            <slot />
          </main>
          <Footer editPath={editPath} />
        </div>
      </div>
    </div>
  </body>
</html>
